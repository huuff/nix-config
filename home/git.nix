{ config, pkgs, ... }:
{
  home.packages = with pkgs; [
    worktrunk
  ];

  sops.secrets.gitWorkConfig = { };

  programs.git = {
    enable = true;
    signing.key = "7E66BB1D1107BA57";
    signing.format = "openpgp";

    ignores = [
      "*~"
      "*.swp" # vim swap files
      "texfrag" # trash generated by texfrag in emacs
      "\\#*\\#" # emacs swap files
      "/result/" # nix outputs
      "/result-data/" # something related to nix output
      ".idea" # Jetbrains IDEA configuration
      "build" # gradle output
      ".gradle" # some gradle specifics I dunno
      "hs_err_pid*.log" # some Java crash logs
      "replay_pid*.log" # other random Java crash logs I guess
    ];

    settings = {
      user = {
        name = "Haf";
        email = "haf@protonmail.ch";
      };
      alias = {
        co = "checkout";
        ss = "status";
        cm = "commit -m";
      };
      credential.helper = "cache --timeout=3600";
      init.defaultBranch = "main";
      merge = {
        # Always creates a merge commit, even if a merge can be fast-forwarded.
        # If the commits are fast-forwarded, these might be very bulk in the history
        # of the base branch and make it difficult to use debugging tools like bisect,
        # or force you to revert them all if you wan't to undo the merge.

        # On the other hand, if you have a merge commit, you can just revert it by
        # choosing a mainline branch
        ff = "false";
      };
      push = {
        # Automatically set up the upstream remote on first push, so
        # `git push` works on new branches without `--set-upstream`.
        autoSetupRemote = true;
      };
      pull = {
        # Only enable fast-forward pulls by default, and force choosing between
        # rebasing and merging if there are conflicts, to ensure you can choose
        # the best strategy to get the best history possible
        ff = "only";
        # TODO: Remove this? ff should cover it
        rebase = "false";
      };
      # re-use older conflict resolutions
      # totally necessary when working on long-lived branches or
      # you'll go crazy
      rerere.enabled = true;
    };

    includes = [
      {
        condition = "gitdir:~/work/";
        path = config.sops.secrets.gitWorkConfig.path;
      }
    ];

    iniContent = {
      blame.ignoreRevsFile = ".git-blame-ignore-revs";
    };
  };

  programs.delta = {
    enable = true;
    enableGitIntegration = true;
    options = {
      line-numbers = true;
      side-by-side = true; # FUTURE: Wait for (https://github.com/dandavison/delta/issues/359)
    };
  };

  # Pipeline so .env etc. exist before direnv runs. Blocking (pre-start) so the shell lands in a ready worktree.
  xdg.configFile."worktrunk/config.toml".text = ''
    [[pre-start]]
    copy-ignored = "wt step copy-ignored"

    [[pre-start]]
    direnv = "! test -f .envrc || direnv allow"
    # theme-by-language writes the theme into .vscode/settings.json; keep that out of commits
    vscode-settings = "git update-index --assume-unchanged .vscode/settings.json 2>/dev/null || true"
  '';

  # worktrunk shell integration: lets `wt switch` cd into worktrees
  programs.bash.initExtra = ''
    eval "$(wt config shell init bash)"
  '';
  programs.zsh.initContent = ''
    eval "$(wt config shell init zsh)"
  '';

}
